if(NOT SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()
file(READ "${SOURCE_ROOT}/LICENSE" _license)
if(NOT _license MATCHES "Apache License" OR NOT _license MATCHES "Version 2.0, January 2004")
    message(FATAL_ERROR "Root LICENSE is not the Apache License, Version 2.0")
endif()
if(_license MATCHES "MIT License" OR _license MATCHES "Permission is hereby granted")
    message(FATAL_ERROR "Root LICENSE still carries the MIT license text")
endif()
file(READ "${SOURCE_ROOT}/NOTICE" _notice)
if(NOT _notice MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "NOTICE is missing Copyright (c) 2026 iisacc")
endif()
file(READ "${SOURCE_ROOT}/README.md" _readme)
if(NOT _readme MATCHES "SPDX-License-Identifier: Apache-2.0")
    message(FATAL_ERROR "README SPDX identifier is not Apache-2.0")
endif()
if(_readme MATCHES "SPDX-License-Identifier: MIT")
    message(FATAL_ERROR "README still identifies the MIT license")
endif()
file(READ "${SOURCE_ROOT}/docs/License.md" _korean)
if(NOT _korean MATCHES "SPDX-License-Identifier: Apache-2.0")
    message(FATAL_ERROR "docs/License.md SPDX identifier is not Apache-2.0")
endif()
file(READ "${SOURCE_ROOT}/cmake/iiJsonConfig.cmake.in" _config_in)
if(NOT _config_in MATCHES "set\\(iiJson_SPDX_LICENSE \"Apache-2.0\"\\)")
    message(FATAL_ERROR "iiJson package template does not export Apache-2.0")
endif()
file(READ "${SOURCE_ROOT}/example/CoreValue/cmake/iiJsonCoreValueConfig.cmake.in" _core_value)
if(NOT _core_value MATCHES "set\\(iiJsonCoreValue_SPDX_LICENSE \"Apache-2.0\"\\)")
    message(FATAL_ERROR "iiJsonCoreValue package template does not export Apache-2.0")
endif()
if(PACKAGE_CONFIG)
    if(NOT EXISTS "${PACKAGE_CONFIG}")
        message(FATAL_ERROR "Generated package config is missing: ${PACKAGE_CONFIG}")
    endif()
    file(READ "${PACKAGE_CONFIG}" _generated)
    if(NOT _generated MATCHES "set\\(iiJson_SPDX_LICENSE \"Apache-2.0\"\\)")
        message(FATAL_ERROR "Generated iiJson package config does not export Apache-2.0")
    endif()
endif()
