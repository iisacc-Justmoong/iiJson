@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/iiJsonTargets.cmake")
foreach(_component IN LISTS iiJson_FIND_COMPONENTS)
    if(_component STREQUAL "Codec" OR _component STREQUAL "Schema" OR _component STREQUAL "Ontology")
        set(iiJson_${_component}_FOUND TRUE)
    else()
        set(iiJson_${_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(iiJson)
